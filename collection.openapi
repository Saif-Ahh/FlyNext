                "properties": {
                  "checkIn": {
                    "type": "string",
                    "example": "March 6, 2025"
                  },
                  "checkOut": {
                    "type": "string",
                    "example": "March 10, 2025"
                  },
                  "hotelId": {
                    "type": "string",
                    "example": "9fd9d9c7-827c-4589-a6e0-d73042a69bd3"
                  },
                  "roomNum": {
                    "type": "number",
                    "example": 8
                  },
                  "roomType": {
                    "type": "string",
                    "example": "Single"
                  }
                }
              },
              "examples": {
                "Add Hotel Booking": {
                  "value": {
                    "checkIn": "March 6, 2025",
                    "checkOut": "March 10, 2025",
                    "hotelId": "9fd9d9c7-827c-4589-a6e0-d73042a69bd3",
                    "roomNum": 8,
                    "roomType": "Single"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
