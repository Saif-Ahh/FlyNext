    "/api/hotels/addHotel": {
      "post": {
        "tags": [
          "Hotel Management"
        ],
        "summary": "Add Hotel",
        "description": "Add Hotel",
        "operationId": "addHotel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "address": {
                    "type": "string",
                    "example": "123 Main St, City"
                  },
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "example": "https://example.com/image1.png"
                    },
                    "example": [
                      "https://example.com/image1.png",
                      "https://example.com/image2.png"
                    ]
                  },
                  "location": {
                    "type": "string",
                    "example": "Idaho, USA"
                  },
                  "logo": {
                    "type": "string",
                    "example": "https://example.com/logo.png"
                  },
                  "name": {
                    "type": "string",
                    "example": "The Even Less Alright Hotel"
                  },
                  "starRating": {
                    "type": "number",
                    "example": 4
                  }
                }
              },
              "examples": {
                "Add Hotel": {
                  "value": {
                    "address": "123 Main St, City",
                    "images": [
                      "https://example.com/image1.png",
                      "https://example.com/image2.png"
                    ],
                    "location": "Idaho, USA",
                    "logo": "https://example.com/logo.png",
                    "name": "The Even Less Alright Hotel",
                    "starRating": 4
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/hotels/addRoomType": {
      "post": {
        "tags": [
          "Hotel Management"
        ],
        "summary": "Add Room",
        "description": "Add Room",
        "operationId": "addRoom",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amenities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "example": "Basketball"
                    },
                    "example": [
                      "Basketball",
                      "Tennis",
                      "Snorkling",
                      "Wi-fi",
                      "Alcohol",
                      "Lounge",
                      "All-inclusive"
                    ]
                  },
                  "hotelId": {
                    "type": "string",
                    "example": "9fd9d9c7-827c-4589-a6e0-d73042a69bd3"
                  },
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "example": "https://example.com/image1.png"
                    },
                    "example": [
                      "https://example.com/image1.png",
                      "https://example.com/image2.png"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "example": "Single"
                  },
                  "pricePerNight": {
                    "type": "number",
                    "example": 999.99
                  },
                  "roomNum": {
                    "type": "number",
                    "example": 10
                  }
                }
              },
              "examples": {
                "Add Room": {
                  "value": {
                    "amenities": [
                      "Basketball",
                      "Tennis",
                      "Snorkling",
                      "Wi-fi",
                      "Alcohol",
                      "Lounge",
                      "All-inclusive"
                    ],
                    "hotelId": "9fd9d9c7-827c-4589-a6e0-d73042a69bd3",
                    "images": [
                      "https://example.com/image1.png",
                      "https://example.com/image2.png"
                    ],
                    "name": "Single",
                    "pricePerNight": 999.99,
                    "roomNum": 10
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/hotels/addHotelBooking": {
      "post": {
