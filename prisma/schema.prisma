generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                String   @id @default(uuid())
  firstName         String
  lastName          String
  email             String   @unique
  password          String
  profilePicture    String
  phoneNumber       String
  passportNumber    String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  bookingReferences Json     @default("[]")
  hotelBookings      Json     @default("[]")
  notifications     Notification[]
  hotels            Hotel[]  @relation("UserHotels")
}

model Hotel {
  id           String   @id @default(uuid())
  userId       String
  name         String
  logo         String
  address      String
  location     String
  starRating   Int
  images       Json

  rooms        Room[]
  notifications Notification[]

  user         User     @relation("UserHotels", fields: [userId], references: [id])
}

model Room {
  id            String @id @default(uuid())
  roomNum       Int      
  hotelId       String   
  name          String   
  amenities     Json
  pricePerNight Float    
  images        Json 

  hotel         Hotel    @relation(fields: [hotelId], references: [id])
}

model Notification {
    id           String   @id @default(uuid())
    userId       String
    hotelId      String?
    message      String
    isRead       Boolean  @default(false)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    user         User     @relation(fields: [userId], references: [id])
    hotel        Hotel?   @relation(fields: [hotelId], references: [id])
}
