generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  firstName         String
  lastName          String
  email             String   @unique
  password          String
  profilePicture    String
  phoneNumber       String
  passportNumber    String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  bookingReferences Json     @default("[]")
  hotelBookings      Json     @default("[]")
  notifications     Notification[]
  hotels            Hotel[]  @relation("UserHotels")
  itineraries       Itinerary[]   @relation("UserItineraries")
}

model Itinerary {
  id               String @id @default(uuid())
  hotelBookingRef  String?
  flightBookingRef String?
  userId           String

  user             User @relation("UserItineraries", fields: [userId], references: [id])
}

model Hotel {
  id           String   @id @default(uuid())
  userId       String
  name         String
  logo         String
  address      String
  location     String
  starRating   Int
  images       Json

  rooms        Room[]
  bookings     Booking[]
  notifications Notification[]

  user         User     @relation("UserHotels", fields: [userId], references: [id])
}

model Room {
  id            String @id @default(uuid())
  roomNum       Int      
  hotelId       String   
  name          String   
  amenities     Json
  pricePerNight Float    
  images        Json 

  hotel         Hotel    @relation(fields: [hotelId], references: [id])
  bookings      Booking[]
}

model Booking {
  id            Int      @id @default(autoincrement()) 
  hotelId       String?
  hotelName     String   
  roomType      String   
  roomNum       Int
  price         Decimal
  roomId        String        
  userId        String   
  checkInDate   DateTime 
  checkOutDate  DateTime 
  status        String   
  createdAt     DateTime @default(now()) 

  hotel         Hotel?    @relation(fields: [hotelId], references: [id])
  room          Room     @relation(fields: [roomId], references: [id])
}

model Notification {
    id           String   @id @default(uuid())
    userId       String
    hotelId      String?
    message      String
    isRead       Boolean  @default(false)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    user         User     @relation(fields: [userId], references: [id])
    hotel        Hotel?   @relation(fields: [hotelId], references: [id])
}
