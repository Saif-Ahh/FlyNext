generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                String   @id @default(uuid())
  firstName         String
  lastName          String
  email             String   @unique
  password          String
  profilePicture    String
  phoneNumber       String
  passportNumber    String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  bookingReferences Json     @default("[]")
  hotelBookings      Json     @default("[]")
}
